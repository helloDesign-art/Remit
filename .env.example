# --- Required ---------------------------------------------------------------
# The name this relay announces to other mail servers (HELO) and uses as the
# realm for SMTP logins. It must have an A record pointing to this server's
# public IP (DNS only, not proxied). Ideally the server's reverse DNS (PTR)
# points back to it.
REMIT_HOSTNAME=smtp.example.com

# --- Recommended ------------------------------------------------------------
# Public IP of this server. Used to print the SPF record for each domain.
REMIT_PUBLIC_IP=

# --- Optional ---------------------------------------------------------------
# Where the submission port is published. The default is Docker's host-gateway
# address: reachable by every container on this host, not from the internet.
# Containers connect with `extra_hosts: ["remit:host-gateway"]` and host "remit".
REMIT_BIND_ADDR=172.17.0.1
REMIT_PORT=587

# DKIM selector. Change it only to rotate keys (new selector = new key).
REMIT_DKIM_SELECTOR=remit

# STARTTLS on the submission port: "none" (default, traffic stays on the host)
# or "may" (self-signed certificate; clients must accept it).
REMIT_SUBMISSION_TLS=none

# Limits.
REMIT_MESSAGE_SIZE_MB=25
# Messages per minute accepted from a single client address.
REMIT_CLIENT_RATE_LIMIT=300

# Upstream relay, only if your provider blocks outbound port 25.
# Example: REMIT_RELAYHOST=[smtp.eu.mailgun.org]:587
REMIT_RELAYHOST=
REMIT_RELAY_USER=
REMIT_RELAY_PASSWORD=
